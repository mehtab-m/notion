PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/myNotion1

# Use a long random value in production — tokens are signed with this.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your-secret-key

# Enables HSTS, hides stack traces and error details from API responses.
NODE_ENV=development

BREVO_API_KEY=xkeysib-your-brevo-api-key
BREVO_FROM_EMAIL=verified-sender@yourdomain.com

FRONTEND_URL=http://localhost:5173

# Comma-separated emails that get Product Admin dashboard access
ADMIN_EMAILS=you@example.com

# Set to "true" to bypass rate limiting (local development and tests only)
DISABLE_RATE_LIMIT=false
