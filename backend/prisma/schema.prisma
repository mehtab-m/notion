generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  password            String
  isVerified          Boolean   @default(false)
  verificationCode    String?
  verificationExpires DateTime?
  resetCode           String?
  resetExpires        DateTime?
  /// null = not chosen yet; true = developer (shows Projects); false = non-developer
  isDeveloper         Boolean?
  /// "user" | "admin"
  role                String    @default("user")
  /// Cached active status (grace period or recent activity)
  isActive            Boolean   @default(true)
  /// New users stay active until this date (createdAt + grace days)
  activeGraceUntil    DateTime?
  lastActiveAt        DateTime?
  /// "common" | "premium" | "platinum"
plan                String    @default("common")

/// Premium/Platinum entitlement ends at this date
planExpiresAt       DateTime?

/// Stripe Customer ID
stripeCustomerId         String?   @unique

/// Stripe Subscription ID
stripeSubscriptionId     String?   @unique

/// Stripe subscription status
/// e.g. active, trialing, past_due, canceled, unpaid
stripeSubscriptionStatus String?

/// Stripe Price ID currently attached to the subscription
stripePriceId            String?

/// Current Stripe billing period end
stripeCurrentPeriodEnd   DateTime?

/// Whether subscription cancellation is scheduled for period end
stripeCancelAtPeriodEnd  Boolean   @default(false)
  /// Successful login count (for premium stars welcome animation)
  loginCount          Int       @default(0)
  /// When inactive follow-up email was last sent
  followupEmailSentAt DateTime?
  /// Admin-managed legal / consent flags
  /// { marketingEmails, dataProcessing, termsAccepted, analyticsOptIn, notes }
  legalSettings       Json      @default("{}")
  /// Appearance: { themeId, customThemes: [{id,name,base,tokens}], reducedMotion, density, fontScale }
  themeSettings       Json      @default("{}")
  /// { weeklySummary, productUpdates, habitReminders, focusChime, soundEffects }
  notificationPrefs   Json      @default("{}")
  /// Uploaded avatar path ("/uploads/…") or remote URL
  avatarUrl           String?
  createdAt           DateTime  @default(now())

  projects            Project[]
  books               Book[]
  notes               Note[]
  shows               Show[]
  tables              Spreadsheet[]
  habits              Habit[]
  goals               Goal[]
  stickyNotes         StickyNote[]
  projectMemberships  ProjectMember[]
  sentProjectMessages ProjectMessage[]
  activities          UserActivity[]
  moneyFriends        MoneyFriend[]
  moneyTransactions   MoneyTransaction[]
  focusSessions       FocusSession[]
  inboxItems          InboxItem[]
}

/// A single pomodoro / deep-work block.
model FocusSession {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "focus" | "short-break" | "long-break" | "run"
  kind      String    @default("focus")
  /// Kilometres covered — only set for runs
  distance  Float?
  /// Planned length in minutes
  minutes   Int       @default(25)
  /// Seconds actually elapsed before it ended
  seconds   Int       @default(0)
  completed Boolean   @default(false)
  label     String    @default("")
  /// Optional link back to what the session was for
  linkType  String?
  linkId    String?
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([userId, startedAt])
}

/// Quick-capture inbox — anything typed before it has a home.
model InboxItem {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  text        String
  note        String    @default("")
  tags        String[]  @default([])
  /// "open" | "done" | "archived"
  status      String    @default("open")
  pinned      Boolean   @default(false)
  /// low | medium | high
  priority    String    @default("medium")
  dueDate     DateTime?
  /// Set when promoted into a real record
  convertedTo String?
  convertedId String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, status])
}

model UserActivity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "login" | "app_use"
  type      String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

model Project {
  id          String           @id @default(cuid())
  title       String
  description String           @default("")
  status      String           @default("active")
  priority    String           @default("medium")
  progress    Int              @default(0)
  dueDate     DateTime?
  tags        String[]         @default([])
  tasks       Json             @default("[]")
  dataTables  Json             @default("[]")
  team        String[]         @default([])
  assignees   String[]         @default([])
  color       String           @default("")
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  members     ProjectMember[]
  messages    ProjectMessage[]

  @@index([userId])
}

model ProjectMember {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  email      String
  name       String    @default("")
  status     String    @default("pending")
  invitedBy  String
  createdAt  DateTime  @default(now())
  acceptedAt DateTime?

  @@unique([projectId, email])
  @@index([projectId])
  @@index([userId])
  @@index([email])
}

model ProjectMessage {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId    String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName  String
  text      String
  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([taskId])
}

model MoneyFriend {
  id             String             @id @default(cuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  /// Optional Gmail/email used to link this friend to a real SortLife account
  email          String?
  /// Set when `email` matches a verified SortLife user — enables mutual sync
  linkedUserId   String?
  /// The reciprocal MoneyFriend row on the linked user's side, when mutual
  mirrorFriendId String?
  createdAt      DateTime           @default(now())
  transactions   MoneyTransaction[]

  @@index([userId])
  @@index([linkedUserId])
}

model MoneyTransaction {
  id                  String      @id @default(cuid())
  userId              String
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  friendId            String
  friend              MoneyFriend @relation(fields: [friendId], references: [id], onDelete: Cascade)
  /// "gave" | "received" — from userId's perspective
  type                String
  amount              Float
  note                String      @default("")
  /// Paired transaction on the linked friend's side, when mutual
  mirrorTransactionId String?
  createdAt           DateTime    @default(now())

  @@index([userId])
  @@index([friendId])
}

model Book {
  id          String    @id @default(cuid())
  title       String
  author      String
  status      String    @default("want-to-read")
  currentPage Int       @default(0)
  totalPages  Int       @default(0)
  rating      Float     @default(0)
  genre       String?
  notes       String?
  coverImage  String?
  notebookId  String?
  startedAt   DateTime?
  finishedAt  DateTime?
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  /// Starred by the user — floats to the top of its list
  favorite   Boolean   @default(false)
  /// Set when moved out of the active list into Archive
  archivedAt DateTime?
  /// Set when moved to Trash; purged for real after 30 days
  deletedAt  DateTime?
  tags       String[]  @default([])

  @@index([userId])
}

model Note {
  id         String   @id @default(cuid())
  title      String
  content    String   @default("")
  folder     String   @default("General")
  tags       String[] @default([])
  pinned     Boolean  @default(false)
  color      String   @default("")
  isNotebook Boolean  @default(false)
  parentId   String?
  notebookId String?
  bookId     String?
  blocks     Json     @default("[]")
  order      Int      @default(0)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  /// Starred by the user — floats to the top of its list
  favorite   Boolean   @default(false)
  /// Set when moved out of the active list into Archive
  archivedAt DateTime?
  /// Set when moved to Trash; purged for real after 30 days
  deletedAt  DateTime?

  @@index([userId])
  @@index([notebookId])
}

model Show {
  id             String   @id @default(cuid())
  title          String
  /// "movie" | "series"
  mediaType      String   @default("series")
  platform       String   @default("Other")
  status         String   @default("want-to-watch")
  currentSeason  Int      @default(1)
  currentEpisode Int      @default(0)
  totalSeasons   Int      @default(1)
  rating         Float    @default(0)
  genre          String?
  notes          String?
  posterImage    String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  /// Starred by the user — floats to the top of its list
  favorite   Boolean   @default(false)
  /// Set when moved out of the active list into Archive
  archivedAt DateTime?
  /// Set when moved to Trash; purged for real after 30 days
  deletedAt  DateTime?
  tags       String[]  @default([])

  @@index([userId])
}

model Spreadsheet {
  id        String   @id @default(cuid())
  name      String
  columns   Json     @default("[]")
  rows      Json     @default("[]")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Starred by the user — floats to the top of its list
  favorite   Boolean   @default(false)
  /// Set when moved out of the active list into Archive
  archivedAt DateTime?
  /// Set when moved to Trash; purged for real after 30 days
  deletedAt  DateTime?
  tags       String[]  @default([])

  @@index([userId])
  @@map("tables")
}

model Habit {
  id             String   @id @default(cuid())
  name           String
  description    String   @default("")
  icon           String   @default("✅")
  color          String   @default("var(--accent)")
  frequency      String   @default("daily")
  completedDates String[] @default([])
  streak         Int      @default(0)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  /// Starred by the user — floats to the top of its list
  favorite   Boolean   @default(false)
  /// Set when moved out of the active list into Archive
  archivedAt DateTime?
  /// Set when moved to Trash; purged for real after 30 days
  deletedAt  DateTime?
  tags       String[]  @default([])

  @@index([userId])
}

model Goal {
  id           String    @id @default(cuid())
  title        String
  description  String    @default("")
  /// Deep reason / north-star "why"
  why          String    @default("")
  category     String    @default("personal")
  status       String    @default("not-started")
  /// sprint | season | year | lifetime
  horizon      String    @default("season")
  icon         String    @default("🎯")
  /// 0–100 computed from milestones + micro-wins
  progress     Int       @default(0)
  /// Rolling engagement score
  momentum     Int       @default(0)
  targetDate   DateTime?
  /// [{id,text,done,weight?,dueDate?,children:[{id,text,done}]}]
  milestones   Json      @default("[]")
  /// [{id,key,title,unlockedAt}]
  achievements Json      @default("[]")
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  /// Starred by the user — floats to the top of its list
  favorite   Boolean   @default(false)
  /// Set when moved out of the active list into Archive
  archivedAt DateTime?
  /// Set when moved to Trash; purged for real after 30 days
  deletedAt  DateTime?
  tags       String[]  @default([])

  @@index([userId])
}

model StickyNote {
  id        String   @id @default(cuid())
  content   String   @default("")
  color     String   @default("yellow")
  pinned    Boolean  @default(false)
  posX      Float    @default(0)
  posY      Float    @default(0)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Starred by the user — floats to the top of its list
  favorite   Boolean   @default(false)
  /// Set when moved out of the active list into Archive
  archivedAt DateTime?
  /// Set when moved to Trash; purged for real after 30 days
  deletedAt  DateTime?
  tags       String[]  @default([])

  @@index([userId])
}
